# HiFive Unmatched U-Boot Builder Configuration

# Toolchain Configuration
CROSS_COMPILE=riscv64-buildroot-linux-gnu-
TOOLCHAIN_PATH=/opt/riscv/toolchain

# Source Versions
OPENSBI_VERSION=v1.3
UBOOT_VERSION=v2026.07
LINUX_KERNEL_VERSION=6.6

# Rocky Linux Configuration
ROCKY_VERSION=10
ROCKY_ROOTFS_URL=https://dl.rockylinux.org/pub/rocky/10/images/riscv64/Rocky-10-Container-Base.latest.riscv64.tar.xz

# Fallback to Fedora if Rocky not available
FEDORA_ROOTFS_URL=https://dl.fedoraproject.org/pub/fedora-secondary/releases/38/Container/riscv64/images/Fedora-Container-Base-38-1.6.riscv64.tar.xz

# Image Configuration
IMAGE_NAME=rocky-riscv-unmatched.img
IMAGE_SIZE=4G
ROOT_PASSWORD=rockylinux

# Partition Configuration
SPL_PARTITION_SIZE=1M
UBOOT_PARTITION_SIZE=4M

# QEMU Configuration
QEMU_MEMORY=4G
QEMU_CPUS=4
QEMU_SSH_PORT=2222

# Build Directories
WORKSPACE=/workspace
BUILD_DIR=/workspace/build
OUTPUT_DIR=/workspace/output
